		<db:select doc:name="Select" doc:id="3884bc98-572a-4f8b-ae0c-9f465fa2a0ea" config-ref="Database_Config2">
			<db:sql ><![CDATA[select * from custData]]></db:sql>
		</db:select>
		<ee:transform doc:name="Transform Message" doc:id="626ec321-7728-49d9-93cc-5b9a10eb9ca2">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
	nonNullRecords: (payload filter (
		$.Id != null and
		$.Name != null and
		$.Email != null and
		$.phone != null and
		$.Address != null
	)) as Array,
	
	nullRecords: (payload filter (
		$.Name == null or
		$.Email == null or
		$.phone == null or
		$.Address == null
	)) as Array
}]]></ee:set-payload>
			</ee:message>
			<ee:variables />
		</ee:transform>
		<set-variable value="#[payload.nonNullRecords]" doc:name="Set Variable" doc:id="f060d0f0-80b3-404a-85c7-314b9f639dce" variableName="nonNullRecords" />
		<logger level="INFO" doc:name="Logger" doc:id="77577ea7-d4f3-4e7c-b47f-2f794dc4793e" message="#[vars.nonNullRecords]"/>
		<set-variable value="#[payload.nullRecords]" doc:name="Set Variable" doc:id="53205e68-0f84-461a-8877-c2d5713f12fe" variableName="nullRecords" />
		<logger level="INFO" doc:name="Logger" doc:id="753dbe8a-1c6b-4c87-9e6e-4d02f64cbc71" message="#[vars.nullRecords]"/>
		<scatter-gather doc:name="Scatter-Gather" doc:id="d3cd98f1-5e83-4dd5-944b-c6f093aef48c" >
			<route >
				<ee:transform doc:name="Transform Message" doc:id="fbab7378-a1e1-430c-b8ab-6ee72c242a1a">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
vars.nonNullRecords map ( nonNullRecords , indexOfNonNullRecord ) -> {
	Name: nonNullRecords.Name,
	Customer_ID__c: nonNullRecords.Id as String,
	Email__c: nonNullRecords.Email,
	Phone__c: nonNullRecords.phone,
	Address__c: nonNullRecords.Address
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<salesforce:upsert doc:name="Upsert" doc:id="00b446da-8b23-403b-9007-25fd05b37a6c" config-ref="Salesforce_Config" objectType="Customer_Profile__c" externalIdFieldName="Email__c" />
				<logger level="INFO" doc:name="Logger" doc:id="22f08794-a0da-4350-aeec-d982c1d2b2d4" message="upsert logger_1"/>
